# 服务端口
PORT=3300

# 单用户鉴权 token（与小程序 request.ts 的 API_TOKEN 一致，务必改成随机长串）
API_TOKEN=change-me-to-a-long-random-string

# LLM 配置（OpenAI 兼容端点；默认 DeepSeek，可换 Qwen/Kimi）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# SQLite 数据文件路径（默认 data/app.db，相对 server 目录）
DB_PATH=data/app.db

# 视觉模型（拍照算卡路里；OpenAI 兼容端点，默认 DashScope qwen-vl）
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen-vl-plus
